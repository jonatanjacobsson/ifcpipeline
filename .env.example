# ifcpipeline — copy this file to `.env` before `docker compose up`.
#
#   cp .env.example .env
#   cp seaweedfs/s3.json.example seaweedfs/s3.json
#
# Then replace every `change-me-*` value. S3_ACCESS_KEY / S3_SECRET_KEY MUST
# match accessKey / secretKey in seaweedfs/s3.json (that file is gitignored).
#
# Compose fails interpolation if these are missing or commented out:
#   IFC_PIPELINE_API_KEY, POSTGRES_PASSWORD, S3_ACCESS_KEY, S3_SECRET_KEY
# N8N_ENCRYPTION_KEY is not a hard compose error, but a blank key breaks n8n
# credential encryption — always set it.
# WORKER_VM_IP is optional (Dozzle remote agent only).

# ---------------------------------------------------------------------------
# API Gateway
# ---------------------------------------------------------------------------
# Generate: uuidgen  (or any long random string)
IFC_PIPELINE_API_KEY=change-me-to-a-secure-random-string

# CIDR ranges that skip API-key auth. Adjust the Docker bridge subnet to match
# `docker network inspect ifcpipeline_default` after first up (often 172.18 or 172.19).
IFC_PIPELINE_ALLOWED_IP_RANGES=127.0.0.1/32,172.18.0.0/16
# Docker bridge gateway — external traffic arrives via this; never whitelist it.
DOCKER_GATEWAY_IP=172.18.0.1

# Local defaults. For production, use public HTTPS hostnames.
IFC_PIPELINE_EXTERNAL_URL=http://localhost:8000
IFC_PIPELINE_PREVIEW_EXTERNAL_URL=http://localhost:8001

# ---------------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------------
N8N_WEBHOOK_URL=http://localhost:5678
N8N_COMMUNITY_PACKAGES_ENABLED=true
N8N_DB_TYPE=postgresdb
N8N_POSTGRESDB_DATABASE=n8n
N8N_POSTGRESDB_USER=ifcpipeline
# Generate: openssl rand -base64 32
# If you restore a production n8n DB dump, this MUST be the key that encrypted it.
N8N_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32
# Public API key for the dashboard's n8n page (n8n → Settings → API → create key).
# Leave blank to have that page report n8n as offline; nothing else depends on it.
N8N_API_KEY=

# ---------------------------------------------------------------------------
# Dashboard (http://localhost:9181)
# ---------------------------------------------------------------------------
# Root the Network Share browser is confined to. Compose mounts ./shared/uploads
# and ./shared/output underneath it; override the volumes in
# docker-compose.control-plane.yml to browse a CIFS/NFS share instead.
NETWORK_SHARE_PATH=/share
# Directory scanned for per-job log files named `<job_id>-*` (shown in job detail).
WORKER_LOGS_DIR=/share/logs

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=ifcpipeline
POSTGRES_PASSWORD=change-me-to-a-secure-password
POSTGRES_DB=ifcpipeline
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis (internal — do not publish 6379 to the public internet)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Object storage (SeaweedFS S3)
# ---------------------------------------------------------------------------
# seaweedfs-setup interpolates S3_ACCESS_KEY / S3_SECRET_KEY with `:?` — they
# cannot be empty. Keep them in sync with seaweedfs/s3.json.
USE_OBJECT_STORAGE=true
S3_ENDPOINT_URL=http://seaweedfs:8333
# Presigned URLs must resolve in browsers (not Docker service names).
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=change-me-s3-access-key
S3_SECRET_KEY=change-me-s3-secret-key
S3_BUCKET=ifcpipeline
S3_REGION=us-east-1
S3_CHECKSUM_MODE=app

# Legacy SeaweedFS dual-write shadow vars (obsolete — leave empty).
S3_SHADOW_ENDPOINT_URL=
S3_SHADOW_ACCESS_KEY=
S3_SHADOW_SECRET_KEY=
S3_SHADOW_BUCKET=
S3_SHADOW_REGION=

# ---------------------------------------------------------------------------
# Remote workers / Dozzle (all optional — single-host does not need these)
# ---------------------------------------------------------------------------
# If set, Dozzle connects to dozzle-agent on the worker at WORKER_VM_IP:7007.
# Leave unset on a fresh clone / single host.
# WORKER_VM_IP=10.0.0.2
# PIPELINE_LAN_IP is auto-synced on boot by scripts/apply-host-lan-access.sh
# (used in generated .env.remote; Docker no longer binds to this IP directly).
# PIPELINE_LAN_IP=10.0.0.1
# WORKER_HOSTNAME=worker-host
# PIPELINE_HOST=primary-host
# REMOTE_SSH=bimbotw1
# REMOTE_REPO=/home/bimbot-w1/apps/ifcpipeline

# ---------------------------------------------------------------------------
# Optional worker tuning
# ---------------------------------------------------------------------------
# Optional: MEP coordination worker (private ifc-coord git submodule).
# COMPOSE_PROFILES=ifccoord
# git submodule update --init ifc-coord
# IFCCOORD_LOCAL_REPLICAS=1

# ifcclash-worker hardening (see ifcclash-worker/tasks.py)
# IFCCLASH_GEOMETRY_LIBRARY=cgal
# IFCCLASH_ITERATOR_THREADS=   # unset → min(cpu_count, 8); use 1 for stability
# IFCCLASH_ISOLATE=1           # spawn-isolated clash subprocess (default on)
# IFCCLASH_BVH_CACHE=off
# IFCCLASH_VALIDATE_CACHE=off

# topologicpy-worker
# IFCTOPOLOGY_SPACE_CACHE=off
# IFCTOPOLOGY_CELL_CACHE=off

# ---------------------------------------------------------------------------
# Baserow (BIP001 Gherkin — ifc-gherkin-worker)
# ---------------------------------------------------------------------------
# docker-compose mounts optional ../cde/.env on the worker; if present,
# CDE_BASEROW_API_BASE, CDE_BASEROW_API_KEY, and
# CDE_BASEROW_IDS_PROPERTIES_TABLE_ID are picked up automatically
# (see shared/baserow_bip_type_defining.py). To override without cde/.env:
#   BASEROW_API_BASE=...   BASEROW_API_TOKEN=...
# or the same names CDE uses:
#   CDE_BASEROW_API_BASE=https://your-baserow.example.com/api
#   CDE_BASEROW_API_KEY=your-database-token
#   CDE_BASEROW_IDS_PROPERTIES_TABLE_ID=1234
