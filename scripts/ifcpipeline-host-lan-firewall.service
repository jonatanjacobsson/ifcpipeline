[Unit]
Description=ifcpipeline DOCKER-USER firewall (worker-only LAN ports)
Documentation=file:///home/bimbot-ubuntu/apps/ifcpipeline/DEPLOYMENT.md
After=docker.service network-online.target ifcpipeline-host-lan.service
Wants=network-online.target
Requires=docker.service ifcpipeline-host-lan.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/bimbot-ubuntu/apps/ifcpipeline
ExecStart=/home/bimbot-ubuntu/apps/ifcpipeline/scripts/apply-host-lan-firewall.sh

[Install]
WantedBy=multi-user.target
